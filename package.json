{
    "name": "anatomy-studio",
    "version": "0.1.0",
    "private": true,
    "packageManager": "bun@1.4.2",
    "engines": {
        "node": ">=22.13.0",
        "bun": ">=1.4.2"
    },
    "scripts": {
        "dev": "vite",
        "build": "bun run engine:build && vite build",
        "engine:build": "bun run scripts/build-engine.ts",
        "engine:test": "cd engine && cargo test --workspace --locked",
        "engine:check": "cd engine && cargo clippy --workspace --locked -- -D warnings",
        "preview": "vite preview",
        "check": "tsc --noEmit",
        "lint": "oxlint",
        "test": "vitest run",
        "validate:atlas": "bun scripts/validate-atlas.ts",
        "validate:interactions": "bun scripts/validate-interactions.ts",
        "validate:oxc": "bun scripts/oxc-verify.ts",
        "validate:all": "bun run check && bun run lint && bun run test && bun run validate:atlas && bun run validate:interactions && bun run validate:oxc"
    },
    "dependencies": {
        "@types/three": "^0.186.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lucide-react": "1.46.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwind-merge": "3.7.0",
        "three": "^0.186.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "^22.20.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "happy-dom": "^20.14.5",
        "meshoptimizer": "^1.2.0",
        "oxc-minify": "^0.150.0",
        "oxc-parser": "^0.150.0",
        "oxc-resolver": "^11.24.2",
        "oxc-transform": "^0.150.0",
        "oxlint": "1.83.0",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "^5.0.1"
    },
    "type": "module",
    "license": "MIT"
}
